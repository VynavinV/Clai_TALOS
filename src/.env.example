TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_NAME=Clai-TALOS
ZHIPUAI_API_KEY=your_zhipuai_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
NVIDIA_API_KEY=your_nvidia_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
GROQ_API_KEY=your_groq_api_key
QWEN_API_KEY=your_qwen_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
MISTRAL_API_KEY=your_mistral_api_key
OLLAMA_MODEL=
GOOGLE_API_KEY=your_google_api_key
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_OAUTH_SCOPES=
HIMALAYA_BIN=himalaya
HIMALAYA_CONFIG=
HIMALAYA_DEFAULT_ACCOUNT=
PROJECTS_DIR=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ENABLED=false
# WhatsApp personal mode (bot acts as you, reads/sends via your account)
# Set to "personal" to use your own WhatsApp account (QR code auth)
# Set to "cloud" or leave empty for business Cloud API mode
WHATSAPP_MODE=
WHATSAPP_PERSONAL_ENABLED=false
WHATSAPP_PERSONAL_HEADLESS=true
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_ENABLED=false

# Browser automation (defaults shown)
BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
BROWSER_CHROME_PATH=
BROWSER_CHROME_USER_DATA_DIR=
BROWSER_PROFILE_DIRECTORY=Default
BROWSER_START_IF_NEEDED=1
BROWSER_ALLOW_ISOLATED_FALLBACK=0
BROWSER_ISOLATED_PROFILE_DIR=
BROWSER_STARTUP_TIMEOUT_S=20
BROWSER_DEFAULT_TIMEOUT_MS=15000
# BROWSER_HEADED=0  # Force headed mode (auto-starts Xvfb on headless servers)
# BROWSER_VNC=0     # Start x11vnc for headed mode access
# BROWSER_VNC_PORT=5900

# AI model routing
MAIN_MODEL=anthropic/claude-sonnet-4-20250514
FALLBACK_MODEL=gemini/gemini-3.1-flash-lite
IMAGE_MODEL=
FAST_MODEL=

# Decision model (System One) — fast typed decisions (choice/score/noul)
# Provider: auto | local | ollama | jev | custom
# Auto works by itself: built-in model when Ollama is too old, Ollama 0.40+
# when available, Jev key when set. The built-in model runs inside TALOS
# (package auto-installed; ~850 MB weights download once, ~1.5 GB disk needed).
# LAYA_ENABLED=1
# LAYA_PROVIDER=auto
# LAYA_MODEL=laya
# LAYA_LOCAL_MODEL=english
# LAYA_AUTO_INSTALL=1
# LAYA_AUTO_UPDATE_OLLAMA=1
# LAYA_BASE_URL=
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# LAYA_TIMEOUT_S=5
# LAYA_AUTO_PULL=1
# LAYA_CONFIDENCE_MIN=0.75
# Feature toggles: LAYA_EMAIL_TRIAGE, LAYA_MEMORY_RERANK, LAYA_CONTEXT_COMPACT,
# LAYA_MODEL_TRIAGE, LAYA_BROWSER_AUTO (all default 1)
