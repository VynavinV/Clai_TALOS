<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clai_bg"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/listeningTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/listening_title"
        android:textColor="@color/clai_accent"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="48dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/listening_hint"
        android:textColor="@color/clai_muted"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/liveTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/clai_text"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp"
            android:padding="8dp" />
    </ScrollView>

    <Button
        android:id="@+id/sendButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop_listening"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        style="@style/Widget.Material3.Button.TextButton" />

    <TextView
        android:id="@+id/voiceSessionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/clai_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />
</LinearLayout>
